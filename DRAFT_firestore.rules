rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'name', 'role']) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'companyId']);
    }

    // 2. Companies
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'address', 'phone', 'logo', 'category', 'rating', 'reviewCount']);
    }

    // 3. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Chat Threads
    match /chatThreads/{threadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.userIds;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds;
        allow create: if isSignedIn() && 
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds;
      }
    }
  }
}
